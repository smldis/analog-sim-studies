#!/usr/bin/env python3
"""A fake `bkill -J <name>`, removing the fake farm's record."""

import os
import sys

STATE = os.environ.get("FAKE_LSF_STATE")


def main(argv):
    name = None
    for index, token in enumerate(argv):
        if token == "-J" and index + 1 < len(argv):
            name = argv[index + 1]
    if not name or not STATE:
        return 255
    path = os.path.join(STATE, f"{name}.json")
    if os.path.exists(path):
        os.remove(path)
        sys.stdout.write(f"Job <{name}> is being terminated\n")
        return 0
    return 255


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
